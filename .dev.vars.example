# Copy this file to `.dev.vars` for local `wrangler dev` testing.
# `.dev.vars` is gitignored and must never be committed.
# In production these are set instead via `wrangler secret put <NAME>`.

DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=

# Optional: Reddit login (/reddit commands). Leave empty to disable.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Any long random string, e.g. from `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=
