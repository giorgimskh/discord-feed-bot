{
  "name": "discord-feed-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord slash-command bot on Cloudflare Workers that fetches recent Reddit and RSS posts on demand.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "node scripts/register-commands.js",
    "pretest": "node -e \"require('fs').existsSync('feeds.json')||require('fs').copyFileSync('feeds.example.json','feeds.json')\"",
    "test": "node --test"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=20.10"
  }
}
